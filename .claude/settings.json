{
  "permissions": {
    "deny": [
      "Bash(git *)",
      "PowerShell(git *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/tool/claude_hooks/format_dart.dart\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Formatting Dart file"
          }
        ]
      }
    ]
  }
}
