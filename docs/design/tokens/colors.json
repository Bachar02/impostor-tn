{
  "$description": "Tesskra colour tokens. Two themes: 'public' (paper) for screens the whole table may see, 'private' (carbon) for screens one player sees alone. Hex is #RRGGBB; alpha given separately.",
  "palette": {
    "paper": "#F3EBDD",
    "paperRaised": "#FFFDF7",
    "paperSunken": "#EADFCB",
    "paperEdge": "#C9BEA8",
    "ink": "#1B2A4A",
    "inkMuted": "#4F5A73",
    "inkDisabled": "#8A8FA0",
    "stamp": "#C92D22",
    "stampPressed": "#A9241B",
    "stampText": "#B3261C",
    "mustard": "#E9A820",
    "mustardPressed": "#CF9212",
    "mustardText": "#7A5200",
    "bottle": "#1F6B4E",
    "blueInk": "#24508F",
    "carbon": "#141C30",
    "carbonRaised": "#1E2942",
    "carbonOutline": "#6B7798",
    "carbonMuted": "#B4BACB",
    "coralLight": "#FF8A7A",
    "mintLight": "#7FD1A8",
    "shadowDeep": "#0A0F1C"
  },
  "public": {
    "background": "{palette.paper}",
    "surface": "{palette.paperRaised}",
    "surfaceSunken": "{palette.paperSunken}",
    "textPrimary": "{palette.ink}",
    "textSecondary": "{palette.inkMuted}",
    "textDisabled": "{palette.inkDisabled}",
    "border": "{palette.ink}",
    "borderSubtle": "{palette.paperEdge}",
    "primary": "{palette.stamp}",
    "primaryPressed": "{palette.stampPressed}",
    "onPrimary": "{palette.paperRaised}",
    "accent": "{palette.mustard}",
    "accentPressed": "{palette.mustardPressed}",
    "onAccent": "{palette.ink}",
    "success": "{palette.bottle}",
    "onSuccess": "{palette.paperRaised}",
    "warning": "{palette.mustard}",
    "warningText": "{palette.mustardText}",
    "error": "{palette.stamp}",
    "errorText": "{palette.stampText}",
    "focusRing": "{palette.blueInk}",
    "shadow": "{palette.ink}",
    "scrim": {
      "color": "{palette.carbon}",
      "alpha": 0.6
    }
  },
  "private": {
    "background": "{palette.carbon}",
    "surface": "{palette.carbonRaised}",
    "ticket": "{palette.paper}",
    "onTicket": "{palette.ink}",
    "textPrimary": "{palette.paper}",
    "textSecondary": "{palette.carbonMuted}",
    "textDisabled": "{palette.carbonOutline}",
    "border": "{palette.carbonOutline}",
    "borderStrong": "{palette.paper}",
    "primary": "{palette.mustard}",
    "primaryPressed": "{palette.mustardPressed}",
    "onPrimary": "{palette.carbon}",
    "success": "{palette.mintLight}",
    "error": "{palette.coralLight}",
    "focusRing": "{palette.paper}",
    "shadow": "{palette.shadowDeep}",
    "scrim": {
      "color": "{palette.shadowDeep}",
      "alpha": 0.7
    }
  },
  "role": {
    "$description": "Role colours are for PUBLIC result screens only. Never use them on private screens: both roles must look identical at a glance there. Always pair with icon + label + stamp shape.",
    "civilian": "{palette.blueInk}",
    "onCivilian": "{palette.paperRaised}",
    "impostor": "{palette.stamp}",
    "onImpostor": "{palette.paperRaised}"
  },
  "contrast": {
    "$description": "WCAG 2.x ratios computed for the key pairs (script: docs/design/tools/build_reference.py).",
    "ink_on_paper": 12.01,
    "inkMuted_on_paper": 5.83,
    "onPrimary_on_stamp": 5.32,
    "stampText_on_paper": 5.52,
    "ink_on_mustard": 6.83,
    "bottle_on_paper": 5.42,
    "blueInk_on_paper": 6.77,
    "mustardText_on_paper": 5.85,
    "paper_on_carbon": 14.32,
    "carbonMuted_on_carbon": 8.74,
    "carbonMuted_on_carbonRaised": 7.46,
    "mustard_on_carbon": 8.14,
    "carbonOutline_on_carbon": 3.81,
    "coralLight_on_carbon": 7.4,
    "mintLight_on_carbon": 9.36
  }
}